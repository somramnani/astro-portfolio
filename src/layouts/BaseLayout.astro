---
import "../styles/global.css";
import { siteFeatures } from "../config/site";

const defaultDescription = siteFeatures.showProjects
  ? "Front end developer portfolio for Som Ramnani, featuring selected projects, experience, skills, and contact links."
  : "Front end developer portfolio for Som Ramnani, featuring experience, skills, and contact links.";

const {
  title = "Som Ramnani | Front End Developer",
  description = defaultDescription,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
