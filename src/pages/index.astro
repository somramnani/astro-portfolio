---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Navbar, Hero, About, Experience, Projects, Contact } from "../components";
import { siteFeatures } from "../config/site";
---

<BaseLayout>
  <Navbar />
  <main>
    <Hero />
    <About />
    <Experience />
    {siteFeatures.showProjects && <Projects />}
    <Contact />
  </main>
</BaseLayout>
