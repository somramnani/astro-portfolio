---
import { profile } from "../data/portfolio";

const links = [
  { href: "#home", label: "Home" },
  { href: "#about", label: "About" },
  { href: "#projects", label: "Projects" },
  { href: "#contact", label: "Contact" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-black/10 bg-[#f8f5ef]/95 shadow-sm backdrop-blur-md">
  <nav class="page-shell flex h-16 items-center justify-between gap-5 text-sm font-bold">
    <a href="#home" class="flex items-center gap-2 no-underline" aria-label="Som Ramnani home">
      <span class="grid h-9 w-9 place-items-center rounded-lg bg-[#151515] text-white">SR</span>
      <span class="hidden sm:inline">{profile.name}</span>
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {links.map((link) => <a class="nav-link" href={link.href}>{link.label}</a>)}
    </div>

    <div class="flex items-center gap-3">
      <a class="hidden text-sm font-extrabold no-underline sm:inline" href={`mailto:${profile.email}`}>
        Email
      </a>
      <a class="button button-primary h-10 min-h-10 px-4" href={profile.resume} target="_blank" rel="noreferrer">
        Resume
      </a>
    </div>
  </nav>
</header>
