---
import { projects } from "../data/portfolio";
---

<section id="projects" class="section bg-[#151515] text-white">
  <div class="page-shell">
    <div class="section-heading">
      <div>
        <p class="section-kicker text-[#ffb199]">Projects</p>
        <h2 class="section-title">Selected work with real product shape.</h2>
      </div>
    </div>

    <div class="grid gap-5">
      {projects.map((project, index) => (
        <article class="grid overflow-hidden rounded-lg border border-white/12 bg-white/[0.07] md:grid-cols-[0.9fr_1.1fr]">
          <div class={index % 2 === 1 ? "md:order-2" : ""}>
            <img
              class="h-full min-h-[260px] w-full object-cover"
              src={project.image}
              alt={`${project.title} project screenshot`}
              loading={index === 0 ? "eager" : "lazy"}
              width="900"
              height="620"
            />
          </div>
          <div class="flex flex-col justify-center gap-5 p-6 md:p-9">
            <div>
              <p class="eyebrow text-[#78d4ca]">0{index + 1}</p>
              <h3 class="mt-2 text-3xl font-black md:text-4xl">{project.title}</h3>
            </div>
            <p class="max-w-2xl text-base leading-7 text-white/78 md:text-lg">{project.description}</p>
            <div class="flex flex-wrap gap-2">
              {project.tech.map((tech) => (
                <img
                  class="h-7 rounded"
                  src={tech.icon}
                  alt={tech.name}
                  title={tech.name}
                  loading="lazy"
                  width="110"
                  height="28"
                />
              ))}
            </div>
            <div class="flex flex-wrap gap-3 pt-1">
              <a class="button button-accent" href={project.liveUrl} target="_blank" rel="noreferrer">Live Site</a>
              <a class="button border-white/30 bg-white text-[#151515]" href={project.githubUrl} target="_blank" rel="noreferrer">
                GitHub
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
