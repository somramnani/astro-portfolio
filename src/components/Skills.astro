---
import { skills } from "../data/portfolio";
---

<section id="skills" class="section">
  <div class="page-shell">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Skills</p>
        <h2 class="section-title">Tools I use to ship useful interfaces.</h2>
      </div>
    </div>

    <div class="flex flex-wrap gap-3">
      {skills.map((skill) => (
        <span class="rounded-lg border border-black/15 bg-white px-4 py-3 text-sm font-extrabold shadow-sm">
          {skill}
        </span>
      ))}
    </div>
  </div>
</section>
