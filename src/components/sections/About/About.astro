---
import SectionHeading from "../../ui/SectionHeading.astro";
import { skills } from "../../../data/portfolio";
---

<section id="about" class="section border-y border-black/10 bg-white/50">
  <div class="page-shell grid gap-10 lg:grid-cols-[0.75fr_1.25fr]">
    <SectionHeading kicker="About" title="Front-end engineer shaped by hands-on product work." />
    <div class="grid gap-6 text-lg leading-8 text-[#45423d]">
      <p>
        I am a front-end developer with experience building and improving user-facing products across startup and
        community teams. My work includes creating reusable React and React Native component systems, connecting
        dynamic forms to GraphQL workflows, and writing documentation that helps other developers move faster.
      </p>
      <p>
        I enjoy turning product requirements into responsive, maintainable interfaces and strengthening the code
        around them through testing, pull request reviews, and thoughtful collaboration. My education in web
        development gave me a strong foundation, while hands-on engineering experience continues to shape how I
        solve problems and contribute to a team. Away from code, I am usually snowboarding, cooking, or playing
        basketball.
      </p>
      <div class="flex flex-wrap gap-3 pt-2" aria-label="Technical skills">
        {skills.map((skill) => (
          <span class="rounded-lg border border-black/15 bg-white px-3.5 py-2.5 text-sm font-extrabold leading-none shadow-sm">
            {skill}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
