---
import SectionHeading from "../../ui/SectionHeading.astro";
import { profile } from "../../../data/portfolio";

const contactLinks = [
  { label: "GitHub", href: profile.github, external: true },
  { label: "LinkedIn", href: profile.linkedin, external: true },
  { label: "Resume", href: profile.resume, external: true },
];
---

<section id="contact" class="section">
  <div class="page-shell grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
    <SectionHeading kicker="Contact" title="Let's build something sharp.">
      <p class="mt-6 max-w-2xl text-lg leading-8 text-[#45423d]">
        Have a question, project, role, or idea worth exploring? Message me on LinkedIn or send me an email.
        I’ll get back to you as soon as possible.
      </p>
    </SectionHeading>

    <div class="grid gap-3 sm:grid-cols-2">
      <button
        class="button button-secondary w-full"
        type="button"
        data-copy-email={profile.email}
        data-default-label="Email"
        data-success-label="Copied!"
      >
        <span data-copy-email-label>Email</span>
      </button>
      {contactLinks.map((link) => (
        <a
          class="button button-secondary w-full"
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noreferrer" : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</section>
